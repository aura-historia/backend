# NONSECRET EXAMPLE. Copy outside Git; blank required values intentionally block Compose.
# Compose 2.30+ required (env_file.format: raw). Never print resolved `compose config`.
# Separate machines/projects for dev and prod. No live operation authorized here.
AURA_CONFIG_DIR=/etc/aura-historia/dev
AURA_NETWORK=aura-dev-backend
# Test/isolated default. Real external dependencies need approved egress configuration.
AURA_NETWORK_INTERNAL=true
AURA_HTTPS_PORT=8443

# Full registry@sha256:<digest>, or verified full local sha256:<image-id> for local use.
# Preload/pull exact images separately; services use pull_policy: never. No latest.
API_IMAGE=
WORKER_IMAGE=
CRON_IMAGE=
CRAWLER_IMAGE=
POSTGRES_IMAGE=
OPENSEARCH_IMAGE=
REDIS_IMAGE=
SEQUIN_IMAGE=
CADDY_IMAGE=

# Exact configured Standard SQS source URLs. DLQs are checked by the worker.
QUEUE_PRODUCT_LISTING_OPENSEARCH=
QUEUE_SEARCH_FILTER_PROJECTION=
QUEUE_SEARCH_FILTER_PERCOLATOR=
QUEUE_SEARCH_FILTER_MATCH_NOTIFICATION=
QUEUE_WATCHLIST_NOTIFICATION=
QUEUE_PRODUCT_CONTENT_ASSESSMENT=
QUEUE_PRODUCT_EMBEDDING=
QUEUE_PRODUCT_TRANSLATION=
QUEUE_PRODUCT_LISTING_NORMALIZATION=
QUEUE_NOTIFICATION_DELIVERY=
