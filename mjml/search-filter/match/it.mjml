<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Manrope, Helvetica, Arial, sans-serif" />
            <mj-text color="#1c1c16" font-size="15px" line-height="1.6" />
            <mj-button background-color="#42120f" color="#ffffff" border-radius="4px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #42120f; }
            .filter-name { color: #42120f; font-weight: 600; }
        </mj-style>
        <mj-title>Nuovo risultato per “{{search_filter_name}}”</mj-title>
        <mj-preview>Un nuovo oggetto d'antiquariato corrisponde al tuo filtro di ricerca “{{search_filter_name}}”{{#if title}}: {{title}}{{/if}}</mj-preview>
    </mj-head>

    <mj-body background-color="#F7F4E9" width="600px">

        <!-- Header -->
        <mj-section padding="32px 24px 20px">
        </mj-section>

        <mj-section padding="0 24px">
            <mj-column>
                <mj-divider border-color="#42120f" border-width="2px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#1c1c16" padding-bottom="8px">
                    {{#if first_name}}Ciao {{first_name}},{{else}}Salve,{{/if}}
                </mj-text>
                <mj-text>
                    Abbiamo trovato un oggetto d'antiquariato che corrisponde al tuo filtro di ricerca <span class="filter-name">“{{search_filter_name}}”</span>:
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Product info -->
        <mj-section background-color="#ffffff" padding="0 32px" border-radius="12px">
            <mj-column>
                {{#if title}}
                <mj-text font-family="'Newsreader', Georgia, serif" font-size="22px" font-weight="600" color="#1c1c16" padding-bottom="4px">
                    {{title}}
                </mj-text>
                {{/if}}
                <mj-text font-size="14px" color="#6d625d" padding-bottom="16px">
                    Offerto da <b>{{listing_source_name}}</b>
                </mj-text>
                {{#if image_url}}
                <mj-image src="{{image_url}}" alt="{{listing_source_name}}" padding="0 0 16px" border-radius="8px" />
                {{/if}}
            </mj-column>
        </mj-section>

        <!-- CTA buttons -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column>
                <mj-button href="{{product_listing_url}}" align="center">
                    Vedi su Aura Historia
                </mj-button>
            </mj-column>
            <mj-column>
                <mj-button href="{{view_url}}" background-color="#ffffff" color="#42120f" border="1px solid #d8c1bf" align="center">
                    Vedi sul sito del venditore
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Banner -->
        <mj-section padding="24px 0 0">
            <mj-column>
                <mj-image src="https://assets.aura-historia.com/branding/banner_twitter_slogan.png" alt="Aura Historia" width="600px" border-radius="8px" />
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text color="#6d625d" font-size="13px" line-height="1.5" align="center">
                    Ricevi questa email perché questo prodotto corrisponde al tuo filtro di ricerca <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#42120f;">“{{search_filter_name}}”</a>.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#6d625d" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — Tutti i diritti riservati.
                    <br />
                    <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#42120f;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    <span style="font-family:'Newsreader', Georgia, serif;color:#1c1c16;font-size:14px;font-weight:600;">Note legali</span>
                    <br />
                    Nome commerciale: Aura Historia &middot; Titolare: Julian Bruder Einzelunternehmen
                    <br />
                    Indirizzo: Hardenbergstraße 80, 04275 Leipzig, Germany
                    <br />
                    Contatto: <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a> &middot; Partita IVA: richiesta
                    <br /><br />
                    Se non desideri più ricevere notifiche per questo filtro di ricerca, puoi disattivarle nelle <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#42120f;">impostazioni dei tuoi filtri di ricerca</a>.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
