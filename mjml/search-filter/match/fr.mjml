<mjml lang="fr">
  <mj-head>
    <mj-title>Nouveau résultat pour « {{search_filter_name}} »</mj-title>
    <mj-preview>Une nouvelle antiquité correspond à votre filtre de recherche « {{search_filter_name}} » {{#if title}}: {{title}}{{/if}}</mj-preview>
    <mj-font name="Newsreader" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&amp;display=swap" />
    <mj-font name="Geist" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Geist+Mono:wght@400;500&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Geist, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-wrapper padding="20px 0" />
      <mj-section padding="0 40px" background-color="#F4EEE3" css-class="ah-px" />
      <mj-column padding="0" />
      <mj-text padding="0" color="#4F4441" font-size="16px" line-height="1.6" />
      <mj-image padding="0" />
      <mj-spacer height="28px" />
      <mj-class name="eyebrow" font-family="'Geist Mono', Menlo, Consolas, 'Courier New', monospace" font-size="12px" line-height="1.4" letter-spacing="0.2em" color="#7A5C30" padding="0 0 18px" />
      <mj-class name="headline" font-family="Newsreader, Georgia, 'Times New Roman', serif" font-size="40px" line-height="1.06" letter-spacing="-0.02em" color="#170D0E" css-class="ah-headline" />
      <mj-class name="note" font-size="14px" color="#6B5E58" />
      <mj-class name="footnote" font-size="13px" color="#6B5E58" />
      <mj-divider padding="0 0 24px" border-width="1px" border-color="#D5CFC5" />
    </mj-attributes>
    <mj-style>
      a { color: #170D0E; }
      @media only screen and (max-width: 480px) {
        .ah-px > table > tbody > tr > td { padding-left: 20px !important; padding-right: 20px !important; }
        .ah-headline > div { font-size: 32px !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#EDE5D7" width="600px">
    <mj-wrapper>
    <mj-section background-color="#170D0E" padding="30px 40px" border-radius="14px 14px 0 0">
      <mj-column>
        <mj-text><table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%;"><tr><td style="vertical-align:middle;"><a href="https://aura-historia.com" style="text-decoration:none;"><img src="https://assets.aura-historia.com/branding/email-wordmark.png" alt="Aura Historia" width="151" height="30" style="display:block;width:151px;height:30px;border:0;font-family:Newsreader, Georgia, 'Times New Roman', serif;font-size:18px;letter-spacing:0.22em;color:#F4EEE3;" /></a></td><td align="right" style="vertical-align:middle;text-align:right;font-family:'Geist Mono', Menlo, Consolas, 'Courier New', monospace;font-size:11px;line-height:1.4;letter-spacing:0.16em;color:#B8935A;">ALERTE RECHERCHE</td></tr></table></mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="44px 40px 48px">
      <mj-column>
        <mj-text mj-class="eyebrow">NOUVEAU RÉSULTAT</mj-text>
        <mj-text mj-class="headline">Une nouvelle trouvaille pour <em>«&nbsp;{{search_filter_name}}&nbsp;»</em></mj-text>
        <mj-spacer />
        <mj-text padding="0 0 12px" color="#170D0E">{{#if first_name}}Bonjour {{first_name}},{{else}}Bonjour,{{/if}}</mj-text>
        <mj-text>Une antiquité correspondant à votre filtre de recherche vient d'apparaître sur Aura Historia.</mj-text>
        <mj-spacer />
        <mj-text><table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:separate;background-color:#FBF8F2;border:1px solid #E5DED4;border-radius:14px;">{{#if image_url}}<tr><td style="padding:0;background-color:#E6DDCD;border-radius:15px 15px 0 0;"><a href="{{product_listing_url}}" style="text-decoration:none;"><img src="{{image_url}}" alt="{{#if title}}{{title}}{{else}}{{listing_source_name}}{{/if}}" width="518" style="display:block;width:100%;max-width:518px;height:auto;border:0;border-radius:15px 15px 0 0;" /></a></td></tr>{{/if}}<tr><td style="padding:20px 22px 22px;">{{#if title}}<a href="{{product_listing_url}}" style="text-decoration:none;"><div style="font-family:Newsreader, Georgia, 'Times New Roman', serif;font-size:24px;line-height:1.2;color:#170D0E;padding-bottom:8px;">{{title}}</div></a>{{/if}}<div style="font-family:Geist, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#6B5E58;">Proposé par <strong style="font-weight:600;color:#170D0E;">{{listing_source_name}}</strong></div></td></tr></table></mj-text>
        <mj-spacer />
<mj-text padding="0" font-size="0px" line-height="0"><table role="presentation" border="0" cellpadding="0" cellspacing="0" style="display:inline-table;border-collapse:separate;vertical-align:top;margin:0 6px 10px 0;"><tr><td bgcolor="#170D0E" style="background-color:#170D0E;border-radius:999px;padding:14px 24px;"><a href="{{product_listing_url}}" style="display:inline-block;font-family:Geist, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:500;line-height:20px;color:#FBF8F2;text-decoration:none;white-space:nowrap;">Voir sur Aura Historia<span style="padding-left:8px;">&rarr;</span></a></td></tr></table><table role="presentation" border="0" cellpadding="0" cellspacing="0" style="display:inline-table;border-collapse:separate;vertical-align:top;margin:0 6px 10px 0;"><tr><td style="border:1px solid #BDB6AE;border-radius:999px;padding:13px 23px;"><a href="{{view_url}}" style="display:inline-block;font-family:Geist, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:500;line-height:20px;color:#170D0E;text-decoration:none;white-space:nowrap;">Voir sur le site du marchand</a></td></tr></table></mj-text>
        <mj-spacer />
        <mj-divider />
        <mj-text mj-class="footnote">Vous recevez cet e-mail car cette annonce correspond à votre filtre de recherche <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#170D0E;text-decoration:underline;text-underline-offset:3px;">«&nbsp;{{search_filter_name}}&nbsp;»</a>. Pour ne plus recevoir ces alertes, désactivez-les dans les <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#170D0E;text-decoration:underline;text-underline-offset:3px;">paramètres de vos filtres de recherche</a>.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#170D0E" padding="36px 40px 40px" border-radius="0 0 14px 14px">
      <mj-column>
        <mj-text font-size="14px" color="#D8CABE">
          <div style="padding-bottom:10px;font-family:Newsreader, Georgia, 'Times New Roman', serif;font-size:20px;line-height:1;letter-spacing:0.22em;color:#F4EEE3;">AURA HISTORIA</div>
          <div style="padding-bottom:16px;">Le marché mondial des antiquités, en une seule recherche.</div>
          <div style="padding-bottom:22px;line-height:2;"><a href="https://aura-historia.com" style="color:#F4EEE3;text-decoration:none;">aura-historia.com</a>&nbsp;&nbsp;&nbsp;&nbsp; <a href="mailto:contact@aura-historia.com" style="color:#F4EEE3;text-decoration:none;">contact@aura-historia.com</a></div>
          <div style="border-top:1px solid #362D2C;padding-top:22px;font-size:12px;color:#A8988D;">
            <div style="padding-bottom:10px;font-family:'Geist Mono', Menlo, Consolas, 'Courier New', monospace;font-size:10px;line-height:1.4;letter-spacing:0.14em;color:#D8CABE;">MENTIONS LÉGALES</div>
            <div style="padding-bottom:10px;">Nom commercial&nbsp;: Aura Historia &middot; Titulaire&nbsp;: Julian Bruder Einzelunternehmen<br />Adresse&nbsp;: Hardenbergstraße 80, 04275 Leipzig, Allemagne<br />Contact&nbsp;: contact@aura-historia.com &middot; Numéro de TVA&nbsp;: demandé</div>
            <div>© 2026 Aura Historia — Tous droits réservés.</div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
