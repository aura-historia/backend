<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Manrope, Helvetica, Arial, sans-serif" />
            <mj-text color="#1c1c16" font-size="15px" line-height="1.6" />
            <mj-button background-color="#42120f" color="#ffffff" border-radius="4px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #42120f; }
            .filter-name { color: #42120f; font-weight: 600; }
        </mj-style>
        <mj-title>Nouveau résultat pour « {{search_filter_name}} »</mj-title>
        <mj-preview>Une nouvelle antiquité correspond à votre filtre de recherche « {{search_filter_name}} » {{#if title}}: {{title}}{{/if}}</mj-preview>
    </mj-head>

    <mj-body background-color="#F7F4E9" width="600px">

        <!-- Header -->
        <mj-section padding="32px 24px 20px">
        </mj-section>

        <mj-section padding="0 24px">
            <mj-column>
                <mj-divider border-color="#42120f" border-width="2px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#1c1c16" padding-bottom="8px">
                    {{#if user_first_name}}Bonjour {{user_first_name}},{{else}}Bonjour,{{/if}}
                </mj-text>
                <mj-text>
                    Nous avons trouvé une antiquité correspondant à votre filtre de recherche <span class="filter-name">« {{search_filter_name}} »</span> :
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Product info -->
        <mj-section background-color="#ffffff" padding="0 32px" border-radius="12px">
            <mj-column>
                {{#if title}}
                <mj-text font-family="'Newsreader', Georgia, serif" font-size="22px" font-weight="600" color="#1c1c16" padding-bottom="4px">
                    {{title}}
                </mj-text>
                {{/if}}
                <mj-text font-size="14px" color="#6d625d" padding-bottom="16px">
                    Proposé par <b>{{shop_name}}</b>
                </mj-text>
                {{#if image_url}}
                <mj-image src="{{image_url}}" alt="{{shop_name}}" padding="0 0 16px" border-radius="8px" />
                {{/if}}
            </mj-column>
        </mj-section>

        <!-- CTA buttons -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column>
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}/product-listings/{{product_slug_id}}" align="center">
                    Voir sur Aura Historia
                </mj-button>
            </mj-column>
            <mj-column>
                <mj-button href="{{view_url}}" background-color="#ffffff" color="#42120f" border="1px solid #d8c1bf" align="center">
                    Voir sur le site du vendeur
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Banner -->
        <mj-section padding="24px 0 0">
            <mj-column>
                <mj-image src="https://assets.aura-historia.com/branding/banner_twitter_slogan.png" alt="Aura Historia" width="600px" border-radius="8px" />
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text color="#6d625d" font-size="13px" line-height="1.5" align="center">
                    Vous recevez cet e-mail car ce produit correspond à votre filtre de recherche <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#42120f;">« {{search_filter_name}} »</a>.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#6d625d" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — Tous droits réservés.
                    <br />
                    <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#42120f;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    <span style="font-family:'Newsreader', Georgia, serif;color:#1c1c16;font-size:14px;font-weight:600;">Mentions légales</span>
                    <br />
                    Nom commercial : Aura Historia &middot; Propriétaire : Julian Bruder Einzelunternehmen
                    <br />
                    Adresse : Hardenbergstraße 80, 04275 Leipzig, Germany
                    <br />
                    Contact : <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a> &middot; N° de TVA : demandée
                    <br /><br />
                    Si vous ne souhaitez plus recevoir de notifications pour ce filtre de recherche, vous pouvez les désactiver dans les <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#42120f;">paramètres de vos filtres de recherche</a>.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
