<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
            <mj-text color="#4A4338" font-size="15px" line-height="1.6" />
            <mj-button background-color="#A67C52" color="#ffffff" border-radius="6px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #A67C52; }
            .filter-name { color: #A67C52; font-weight: 600; }
        </mj-style>
        <mj-title>Nouveau résultat pour « {{search_filter_name}} »</mj-title>
        <mj-preview>Une nouvelle antiquité correspond à votre filtre de recherche « {{search_filter_name}} » : {{title}}</mj-preview>
    </mj-head>

    <mj-body background-color="#F8F4EE" width="600px">

        <!-- Header / Brand -->
        <mj-section background-color="#2A261F" padding="24px 32px">
            <mj-column>
                <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-size="26px" font-weight="700" color="#F8F4EE" align="center" letter-spacing="2px" padding="0">
                    Aura Historia
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="0">
            <mj-column>
                <mj-divider border-color="#A67C52" border-width="3px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#4A4338" padding-bottom="8px">
                    {{#if user_first_name}}Bonjour {{user_first_name}},{{else}}Bonjour,{{/if}}
                </mj-text>
                <mj-text>
                    Nous avons trouvé une antiquité correspondant à votre filtre de recherche <span class="filter-name">« {{search_filter_name}} »</span> :
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Product info -->
        <mj-section background-color="#ffffff" padding="0 32px" border-radius="12px">
            <mj-column>
                <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-size="22px" font-weight="600" color="#2A261F" padding-bottom="4px">
                    {{title}}
                </mj-text>
                <mj-text font-size="14px" color="#7D7567" padding-bottom="16px">
                    Proposé par <b>{{shop_name}}</b>
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- CTA buttons -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column>
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}/products/{{product_slug_id}}" align="center">
                    Voir le produit
                </mj-button>
            </mj-column>
            <mj-column>
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}" background-color="transparent" color="#A67C52" inner-padding="10px 30px" border="1.5px solid #A67C52" align="center">
                    Visiter la boutique
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Brand tagline -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-size="13px" color="#7D7567" align="center" letter-spacing="2px" padding="0">
                    DISCOVER · COLLECT · TREASURE
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="12px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="16px 24px 0">
            <mj-column>
                <mj-text color="#7D7567" font-size="13px" line-height="1.5" align="center">
                    Vous recevez cet e-mail car ce produit correspond à votre filtre de recherche <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#A67C52;">« {{search_filter_name}} »</a>.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#7D7567" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — Tous droits réservés.
                    <br />
                    <a href="mailto:contact@aura-historia.com" style="color:#A67C52;text-decoration:none;">contact@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#A67C52;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    Si vous ne souhaitez plus recevoir de notifications pour ce filtre de recherche, vous pouvez les désactiver dans les <a href="https://aura-historia.com/search-filters/{{search_filter_id}}" style="color:#A67C52;">paramètres de vos filtres de recherche</a>.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
