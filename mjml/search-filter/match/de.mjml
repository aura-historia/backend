<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica, Arial, sans-serif"/>
            <mj-text color="#4A4338" font-size="16px" line-height="1.5"/>
            <mj-button background-color="#A67C52" color="#ffffff" border-radius="6px" font-size="16px" padding="16px"/>
            <mj-section padding="0"/>
            <mj-column padding="0"/>
        </mj-attributes>
        <mj-style>
            .title {
                font-family: "Cormorant Garamond", Georgia, serif;
                font-size: 32px !important;
                color: #2A261F;
                font-weight: 500;
                margin-bottom: 12px;
            }

            .subtitle {
                font-family: "Cormorant Garamond", Georgia, serif;
                font-size: 20px !important;
                color: #2A261F;
                margin-bottom: 8px;
            }

            .filter-name {
                color: #A67C52;
                font-weight: 600;
            }
        </mj-style>
        <mj-title>Neues Ergebnis für „{{search_filter_name}}"</mj-title>
        <mj-preview>Ein neues Produkt passt zu Ihrem Suchfilter „{{search_filter_name}}": {{title}}</mj-preview>
    </mj-head>

    <mj-body background-color="#F8F4EE">

        <mj-section padding-top="32px" padding-bottom="16px">
            <mj-column width="100%">
                <mj-text color="#7D7567" font-size="18px">
                    Neuer Treffer für Ihren Suchfilter
                </mj-text>
                <mj-text css-class="subtitle" padding-bottom="8px">{{title}}</mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="32px" border-radius="12px">
            <mj-column>
                <mj-text font-size="18px" color="#4A4338">
                    {{#if userFirstName}}
                    Hallo {{userFirstName}},
                    {{else}}
                    Guten Tag,
                    {{/if}}
                </mj-text>
                <mj-text>
                    Wir haben eine Antiquität gefunden, die zu Ihrem Suchfilter
                    <span class="filter-name">„{{search_filter_name}}"</span> passt:
                </mj-text>
                <mj-text font-size="18px" font-weight="600" color="#2A261F">
                    {{title}}
                </mj-text>
                <mj-text color="#7D7567">
                    Angeboten von <b>{{shop_name}}</b>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="0 32px 32px 32px" border-radius="12px">
            <mj-column width="50%">
                <mj-button href="https://aura-historia.com/product/{{product_slug_id}}">
                    Produkt ansehen
                </mj-button>
            </mj-column>

            <mj-column width="50%">
                <mj-button href="{{productShopUrl}}" background-color="#EDEDED" color="#4A4338" border="1px solid #CFCFCF">
                    Produkt im Shop ansehen
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-section padding="32px 0 0 0">
            <mj-column>
                <mj-text color="#7D7567" font-size="14px">
                    Sie erhalten diese E-Mail, weil dieses Produkt Ihrem Suchfilter „{{search_filter_name}}" entspricht.
                    <br/><br/>
                    © 2026 Aura Historia — Alle Rechte vorbehalten.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column>
                <mj-text color="#7D7567" font-size="13px" line-height="1.6">
                    <strong>Impressum</strong>
                    <br/>
                    Aura Historia
                    <br/>
                    Kontakt: support@aura-historia.com
                    <br/>
                    Website: https://aura-historia.com
                    <br/><br/>
                    Wenn Sie keine Benachrichtigungen mehr zu diesem Suchfilter erhalten möchten,
                    können Sie die Benachrichtigungen in Ihren Suchfilter-Einstellungen deaktivieren.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
