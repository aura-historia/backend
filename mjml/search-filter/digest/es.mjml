<mjml>
<mj-head><mj-title>Nuevos resultados para tus búsquedas guardadas</mj-title><mj-preview>{{match_count}} nuevos resultados para {{listing_count}} artículos</mj-preview>
<mj-attributes><mj-all font-family="Manrope, Helvetica, Arial, sans-serif" /><mj-text color="#1c1c16" font-size="15px" line-height="1.6" /><mj-button background-color="#42120f" color="#ffffff" border-radius="4px" /></mj-attributes></mj-head>
<mj-body background-color="#F7F4E9" width="600px">
<mj-section background-color="#ffffff" padding="32px"><mj-column>
<mj-text font-size="22px">Nuevos resultados para tus búsquedas guardadas</mj-text><mj-text>Hola{{#if first_name}} {{first_name}}{{/if}},</mj-text>
<mj-text>{{match_count}} nuevos resultados para {{listing_count}} artículos.</mj-text>
<mj-text><b>Búsquedas guardadas</b><br />{{#each groups}}<a href="{{url}}">{{name}}</a> ({{match_count}})<br />{{/each}}</mj-text>
</mj-column></mj-section>
<mj-raw>{{#each listings}}</mj-raw>
<mj-section background-color="#ffffff" padding="16px 32px"><mj-column>
<mj-text font-size="20px">{{#if title}}{{title}}{{else}}{{listing_source_name}}{{/if}}</mj-text>
<mj-text>{{listing_source_name}}<br />{{#each searches}}<a href="{{url}}">{{name}}</a><br />{{/each}}</mj-text>
<mj-raw>{{#if image_url}}</mj-raw><mj-image src="{{image_url}}" alt="{{listing_source_name}}" padding="8px 0" /><mj-raw>{{/if}}</mj-raw>
<mj-button href="{{product_listing_url}}">Ver artículo</mj-button>
</mj-column></mj-section>
<mj-raw>{{/each}}</mj-raw>
<mj-section padding="24px 32px"><mj-column>
<mj-text>Mostrando {{preview_count}} de {{listing_count}} artículos. Todos los resultados están disponibles en tus búsquedas guardadas.</mj-text>
<mj-button href="{{results_url}}">Ver todas las búsquedas guardadas</mj-button><mj-text align="center"><a href="{{settings_url}}">Gestionar notificaciones</a></mj-text>
<mj-text align="center" font-size="12px">© 2026 Aura Historia<br />Julian Bruder Einzelunternehmen · Hardenbergstraße 80, 04275 Leipzig, Germany<br /><a href="mailto:contact@aura-historia.com">contact@aura-historia.com</a></mj-text>
</mj-column></mj-section></mj-body></mjml>
