<mjml lang="en" dir="ltr">
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Manrope, Helvetica, Arial, sans-serif" />
            <mj-text color="#1c1c16" font-size="15px" line-height="1.6" />
            <mj-section padding="0" />
