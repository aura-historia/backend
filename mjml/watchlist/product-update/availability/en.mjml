<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Manrope, Helvetica, Arial, sans-serif" />
            <mj-text color="#1c1c16" font-size="15px" line-height="1.6" />
            <mj-button background-color="#42120f" color="#ffffff" border-radius="4px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #42120f; }
            .availability-old { text-decoration: line-through; color: #6d625d; }
            .availability-new { color: #42120f; font-weight: 700; font-size: 18px; }
        </mj-style>
        <mj-title>Availability change{{#if title}}: {{title}}{{/if}}</mj-title>
        <mj-preview>{{#if title}}The availability of "{{title}}" has changed — view details now.{{else}}A watchlist item availability changed — view details now.{{/if}}</mj-preview>
    </mj-head>

    <mj-body background-color="#F7F4E9" width="600px">

        <!-- Header -->
        <mj-section padding="32px 24px 20px">
        </mj-section>

        <mj-section padding="0 24px">
            <mj-column>
                <mj-divider border-color="#42120f" border-width="2px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#1c1c16" padding-bottom="8px">
                    {{#if user_first_name}}Hello {{user_first_name}},{{else}}Hello,{{/if}}
                </mj-text>
                <mj-text>
                    The availability of an antique on your watchlist has changed. Here are the details:
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Product info -->
        <mj-section background-color="#ffffff" padding="0 32px" border-radius="12px">
            <mj-column>
                {{#if title}}
                <mj-text font-family="'Newsreader', Georgia, serif" font-size="22px" font-weight="600" color="#1c1c16" padding-bottom="4px">
                    {{title}}
                </mj-text>
                {{/if}}
                <mj-text font-size="14px" color="#6d625d" padding-bottom="16px">
                    Offered by <b>{{shop_name}}</b>
                </mj-text>
                {{#if image_url}}
                <mj-image src="{{image_url}}" alt="{{shop_name}}" padding="0 0 16px" border-radius="8px" />
                {{/if}}
            </mj-column>
        </mj-section>

        <!-- Availability change highlight -->
        <mj-section background-color="#ffffff" padding="0 32px 8px" border-radius="12px">
            <mj-column>
                <mj-table font-size="15px" color="#1c1c16" cellpadding="6">
                    <tr>
                        <td style="font-weight:600;color:#6d625d;padding:6px 12px 6px 0;">Previous availability</td>
                        <td style="padding:6px 0;">
                            <span class="availability-old">{{#if old_availability}}{{old_availability}}{{else}}n/a{{/if}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:#6d625d;padding:6px 12px 6px 0;">New availability</td>
                        <td style="padding:6px 0;">
                            <span class="availability-new">{{#if new_availability}}{{new_availability}}{{else}}n/a{{/if}}</span>
                        </td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>

        <!-- CTA buttons -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column>
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}/product-listings/{{product_slug_id}}" align="center">
                    View on Aura Historia
                </mj-button>
            </mj-column>
            <mj-column>
                <mj-button href="{{view_url}}" background-color="#ffffff" color="#42120f" border="1px solid #d8c1bf" align="center">
                    View on Merchant Site
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Banner -->
        <mj-section padding="24px 0 0">
            <mj-column>
                <mj-image src="https://assets.aura-historia.com/branding/banner_twitter_slogan.png" alt="Aura Historia" width="600px" border-radius="8px" />
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text color="#6d625d" font-size="13px" line-height="1.5" align="center">
                    You are receiving this email because this antique is on your <a href="https://aura-historia.com/watchlist" style="color:#42120f;">watchlist</a>.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#6d625d" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — All rights reserved.
                    <br />
                    <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#42120f;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    <span style="font-family:'Newsreader', Georgia, serif;color:#1c1c16;font-size:14px;font-weight:600;">Imprint</span>
                    <br />
                    Trade name: Aura Historia &middot; Owner: Julian Bruder Einzelunternehmen
                    <br />
                    Address: Hardenbergstraße 80, 04275 Leipzig, Germany
                    <br />
                    Contact: <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a> &middot; VAT ID: requested
                    <br /><br />
                    If you no longer want to receive notifications about antiques on your watchlist,
                    you can adjust your preferences per antique in your <a href="https://aura-historia.com/watchlist" style="color:#42120f;">watchlist</a>.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
