<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica, Arial, sans-serif"/>
            <mj-text color="#4A4338" font-size="16px" line-height="1.5"/>
            <mj-button background-color="#A67C52" color="#ffffff" border-radius="6px" font-size="16px" padding="16px"/>
            <mj-section padding="0"/>
            <mj-column padding="0"/>
        </mj-attributes>
        <mj-style>
            .title {
                font-family: "Cormorant Garamond", Georgia, serif;
                font-size: 32px !important;
                color: #2A261F;
                font-weight: 500;
                margin-bottom: 12px;
            }

            .subtitle {
                font-family: "Cormorant Garamond", Georgia, serif;
                font-size: 20px !important;
                color: #2A261F;
                margin-bottom: 8px;
            }

            .detail-label {
                font-weight: 600;
                color: #2A261F;
            }

            .price-old {
                text-decoration: line-through;
                color: #7D7567;
            }

            .price-new {
                color: #A67C52;
                font-weight: 600;
            }

            .state-change {
                color: #A67C52;
                font-weight: 600;
            }
        </mj-style>
        <mj-title>Aggiornamento su {{productTitle}}</mj-title>
        <mj-preview>Aggiornamento di un prodotto nella tua lista di osservazione: {{productTitle}}</mj-preview>
    </mj-head>

    <mj-body background-color="#F8F4EE">

        <mj-section padding-top="32px" padding-bottom="16px">
            <mj-column width="100%">
                <mj-text color="#7D7567" font-size="18px">
                    Si è verificato un cambiamento nella tua lista di osservazione
                </mj-text>
                <mj-text css-class="subtitle" padding-bottom="8px">{{productTitle}}</mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="32px" border-radius="12px">
            <mj-column>
                <mj-text font-size="18px" color="#4A4338">
                    {{#if userFirstName}}
                    Gentile {{userFirstName}},
                    {{else}}
                    Gentile cliente,
                    {{/if}}
                </mj-text>
                <mj-text>
                    Uno degli oggetti d'antiquariato che segui è stato aggiornato. Il suo <b>prezzo</b> è cambiato:
                </mj-text>
                <mj-text>
                    <span class="price-old">
                        {{#if productOldPrice}}
                        {{productOldPrice}}
                        {{else}}
                        n. d.
                        {{/if}}
                    </span>
                    →
                    <span class="price-new">
                        {{#if productNewPrice}}
                        {{productNewPrice}}
                        {{else}}
                        n. d.
                        {{/if}}
                    </span>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="0 32px 32px 32px" border-radius="12px">
            <mj-column width="50%">
                <mj-button href="{{productAuraHistoriaUrl}}">
                    Visualizza nella lista di osservazione
                </mj-button>
            </mj-column>

            <mj-column width="50%">
                <mj-button href="{{productShopUrl}}" background-color="#EDEDED" color="#4A4338" border="1px solid #CFCFCF">
                    Visualizza nel negozio
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-section padding="32px 0 0 0">
            <mj-column>
                <mj-text color="#7D7567" font-size="14px">
                    Ricevi questa e-mail perché questo oggetto d'antiquariato si trova nella tua lista di osservazione.
                    <br/><br/>
                    © 2026 Aura Historia — Tutti i diritti riservati.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column>
                <mj-text color="#7D7567" font-size="13px" line-height="1.6">
                    <strong>Note legali</strong>
                    <br/>
                    Aura Historia
                    <br/>
                    Contatto: support@aura-historia.com
                    <br/>
                    Sito web: https://aura-historia.com
                    <br/><br/>
                    Se non desideri più ricevere notifiche sugli oggetti d'antiquariato nella tua lista di osservazione,
                    puoi modificare le tue preferenze per ogni oggetto dalla tua lista.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
