<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
            <mj-text color="#4A4338" font-size="15px" line-height="1.6" />
            <mj-button background-color="#A67C52" color="#ffffff" border-radius="6px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #A67C52; }
            .price-old { text-decoration: line-through; color: #7D7567; }
            .price-new { color: #A67C52; font-weight: 700; font-size: 18px; }
        </mj-style>
        <mj-title>Changement de prix : {{title}}</mj-title>
        <mj-preview>Le prix de « {{title}} » a changé — voir les détails.</mj-preview>
    </mj-head>

    <mj-body background-color="#F8F4EE" width="600px">

        <!-- Header -->
        <mj-section padding="32px 24px 20px">
            <mj-column>
                <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-size="28px" font-weight="600" color="#2A261F" align="center">
                    Aura Historia
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="0 24px">
            <mj-column>
                <mj-divider border-color="#A67C52" border-width="2px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#4A4338" padding-bottom="8px">
                    {{#if user_first_name}}Bonjour {{user_first_name}},{{else}}Bonjour,{{/if}}
                </mj-text>
                <mj-text>
                    Une antiquité de votre liste de suivi a un nouveau prix. Voici les détails :
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Product info -->
        <mj-section background-color="#ffffff" padding="0 32px" border-radius="12px">
            <mj-column>
                <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-size="22px" font-weight="600" color="#2A261F" padding-bottom="4px">
                    {{title}}
                </mj-text>
                <mj-text font-size="14px" color="#7D7567" padding-bottom="16px">
                    Proposé par <b>{{shop_name}}</b>
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Price change highlight -->
        <mj-section background-color="#ffffff" padding="0 32px 8px" border-radius="12px">
            <mj-column>
                <mj-table font-size="15px" color="#4A4338" cellpadding="6">
                    <tr>
                        <td style="font-weight:600;color:#7D7567;padding:6px 12px 6px 0;">Ancien prix</td>
                        <td style="padding:6px 0;">
                            <span class="price-old">{{#if old_price}}{{old_price}}{{else}}n.&nbsp;c.{{/if}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:#7D7567;padding:6px 12px 6px 0;">Nouveau prix</td>
                        <td style="padding:6px 0;">
                            <span class="price-new">{{#if new_price}}{{new_price}}{{else}}n.&nbsp;c.{{/if}}</span>
                        </td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>

        <!-- CTA buttons -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column width="50%">
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}/products/{{product_slug_id}}">
                    Voir le produit
                </mj-button>
            </mj-column>
            <mj-column width="50%">
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}" background-color="#EDEDED" color="#4A4338" border="1px solid #CFCFCF">
                    Visiter la boutique
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Banner -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-image src="https://assets.aura-historia.com/branding/banner_twitter_slogan.png" alt="Aura Historia" width="600px" border-radius="8px" />
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text color="#7D7567" font-size="13px" line-height="1.5" align="center">
                    Vous recevez cet e-mail car cette antiquité figure dans votre liste de suivi.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#7D7567" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — Tous droits réservés.
                    <br />
                    <a href="mailto:support@aura-historia.com" style="color:#A67C52;text-decoration:none;">support@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#A67C52;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    Si vous ne souhaitez plus recevoir de notifications concernant les antiquités de votre liste de suivi,
                    vous pouvez ajuster vos préférences pour chaque antiquité directement dans votre liste.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
