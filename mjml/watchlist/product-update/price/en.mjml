<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
            <mj-text color="#4A4338" font-size="15px" line-height="1.6" />
            <mj-button background-color="#A67C52" color="#ffffff" border-radius="6px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #A67C52; }
            .price-old { text-decoration: line-through; color: #7D7567; }
            .price-new { color: #A67C52; font-weight: 700; font-size: 18px; }
        </mj-style>
        <mj-title>Price change: {{title}}</mj-title>
        <mj-preview>The price for "{{title}}" has changed — view details now.</mj-preview>
    </mj-head>

    <mj-body background-color="#F8F4EE" width="600px">

        <!-- Header -->
        <mj-section padding="32px 24px 20px">
        </mj-section>

        <mj-section padding="0 24px">
            <mj-column>
                <mj-divider border-color="#A67C52" border-width="2px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#4A4338" padding-bottom="8px">
                    {{#if user_first_name}}Hello {{user_first_name}},{{else}}Hello,{{/if}}
                </mj-text>
                <mj-text>
                    An antique on your watchlist has a new price. Here are the details:
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Product info -->
        <mj-section background-color="#ffffff" padding="0 32px" border-radius="12px">
            <mj-column>
                <mj-text font-family="'Cormorant Garamond', Georgia, serif" font-size="22px" font-weight="600" color="#2A261F" padding-bottom="4px">
                    {{title}}
                </mj-text>
                <mj-text font-size="14px" color="#7D7567" padding-bottom="16px">
                    Offered by <b>{{shop_name}}</b>
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Price change highlight -->
        <mj-section background-color="#ffffff" padding="0 32px 8px" border-radius="12px">
            <mj-column>
                <mj-table font-size="15px" color="#4A4338" cellpadding="6">
                    <tr>
                        <td style="font-weight:600;color:#7D7567;padding:6px 12px 6px 0;">Previous price</td>
                        <td style="padding:6px 0;">
                            <span class="price-old">{{#if old_price}}{{old_price}}{{else}}n/a{{/if}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:#7D7567;padding:6px 12px 6px 0;">New price</td>
                        <td style="padding:6px 0;">
                            <span class="price-new">{{#if new_price}}{{new_price}}{{else}}n/a{{/if}}</span>
                        </td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>

        <!-- CTA buttons -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column>
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}/products/{{product_slug_id}}" align="center">
                    View Product
                </mj-button>
            </mj-column>
            <mj-column>
                <mj-button href="https://aura-historia.com/shops/{{shop_slug_id}}" background-color="#EDEDED" color="#4A4338" border="1px solid #CFCFCF" align="center">
                    Visit Shop
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Banner -->
        <mj-section padding="24px 0 0">
            <mj-column>
                <mj-image src="https://assets.aura-historia.com/branding/banner_twitter_slogan.png" alt="Aura Historia" width="600px" border-radius="8px" />
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text color="#7D7567" font-size="13px" line-height="1.5" align="center">
                    You are receiving this email because this antique is on your <a href="https://aura-historia.com/watchlist" style="color:#A67C52;">watchlist</a>.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#7D7567" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — All rights reserved.
                    <br />
                    <a href="mailto:contact@aura-historia.com" style="color:#A67C52;text-decoration:none;">contact@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#A67C52;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    If you no longer want to receive notifications about antiques on your watchlist,
                    you can adjust your preferences per antique in your <a href="https://aura-historia.com/watchlist" style="color:#A67C52;">watchlist</a>.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
