<mjml>
  <mj-head>
    <mj-title>Mise à jour de votre demande de partenariat : {{party_name}}</mj-title>
    <mj-preview>Une mise à jour de votre demande de partenariat pour {{listing_source_name}}.</mj-preview>
  </mj-head>
  <mj-body background-color="#F7F4E9" width="600px">
    <mj-section background-color="#ffffff" padding="32px" border-radius="12px">
      <mj-column>
        <mj-text>{{#if first_name}}Bonjour {{first_name}},{{else}}Bonjour,{{/if}}</mj-text>
        <mj-text>Votre demande de partenariat pour <b>{{party_name}}</b> et <b>{{listing_source_name}}</b> n’a pas été approuvée cette fois.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
