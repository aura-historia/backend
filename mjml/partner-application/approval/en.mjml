<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="Manrope, Helvetica, Arial, sans-serif" />
            <mj-text color="#1c1c16" font-size="15px" line-height="1.6" />
            <mj-button background-color="#42120f" color="#ffffff" border-radius="4px" font-size="15px" inner-padding="12px 32px" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-divider border-color="#E8E0D6" border-width="1px" />
        </mj-attributes>
        <mj-style>
            a { color: #42120f; }
        </mj-style>
        <mj-title>Partner application approved: {{shop_name}}</mj-title>
        <mj-preview>Great news — your partner application for "{{shop_name}}" has been approved!</mj-preview>
    </mj-head>

    <mj-body background-color="#F7F4E9" width="600px">

        <!-- Header -->
        <mj-section padding="32px 24px 20px">
        </mj-section>

        <mj-section padding="0 24px">
            <mj-column>
                <mj-divider border-color="#42120f" border-width="2px" padding="0" />
            </mj-column>
        </mj-section>

        <!-- Content card -->
        <mj-section background-color="#ffffff" padding="32px 32px 16px" border-radius="12px">
            <mj-column>
                <mj-text font-size="16px" color="#1c1c16" padding-bottom="8px">
                    {{#if user_first_name}}Hello {{user_first_name}},{{else}}Hello,{{/if}}
                </mj-text>
                <mj-text>
                    We are delighted to inform you that your partner application for <b>{{shop_name}}</b> has been approved. Welcome to Aura Historia!
                </mj-text>
                <mj-text>
                    You can now create an API key and start publishing your product listings to Aura Historia. Visit your <a href="https://aura-historia.com/partners">partner overview</a> to learn how to get started, or go directly to your <a href="https://aura-historia.com/partners/dashboard">partner dashboard</a> to create your API key.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- CTA button -->
        <mj-section background-color="#ffffff" padding="8px 32px 32px" border-radius="12px">
            <mj-column>
                <mj-button href="https://aura-historia.com/partners/dashboard" align="center">
                    Go to Partner Dashboard
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Banner -->
        <mj-section padding="24px 0 0">
            <mj-column>
                <mj-image src="https://assets.aura-historia.com/branding/banner_twitter_slogan.png" alt="Aura Historia" width="600px" border-radius="8px" />
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 24px 0">
            <mj-column>
                <mj-text color="#6d625d" font-size="13px" line-height="1.5" align="center">
                    You are receiving this email because you submitted a partner application for <b>{{shop_name}}</b> on <a href="https://aura-historia.com" style="color:#42120f;">Aura Historia</a>.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 0">
            <mj-column>
                <mj-divider />
            </mj-column>
        </mj-section>

        <mj-section padding="8px 24px 32px">
            <mj-column>
                <mj-text color="#6d625d" font-size="12px" line-height="1.6" align="center">
                    © 2026 Aura Historia — All rights reserved.
                    <br />
                    <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://aura-historia.com" style="color:#42120f;text-decoration:none;">aura-historia.com</a>
                    <br /><br />
                    <span style="font-family:'Newsreader', Georgia, serif;color:#1c1c16;font-size:14px;font-weight:600;">Imprint</span>
                    <br />
                    Trade name: Aura Historia &middot; Owner: Julian Bruder Einzelunternehmen
                    <br />
                    Address: Hardenbergstraße 80, 04275 Leipzig, Germany
                    <br />
                    Contact: <a href="mailto:contact@aura-historia.com" style="color:#42120f;text-decoration:none;">contact@aura-historia.com</a> &middot; VAT ID: requested
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>
