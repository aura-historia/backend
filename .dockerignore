!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!src
!src/**
!infra
!infra/assets
!infra/assets/rds-ca-layer
!infra/assets/rds-ca-layer/aura-historia
!infra/assets/rds-ca-layer/aura-historia/rds-ca
!infra/assets/rds-ca-layer/aura-historia/rds-ca/global-bundle.pem
**/target
**/validation
**/certs
**/certs/**
**/secrets
**/secrets/**
**/.env
**/.env.*
**/credentials*
**/*private*.pem
**/*.key
**/*.p12
**/*.pfx
