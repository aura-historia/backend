# The host IAM user's key, as in aws.env.
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# Repository encryption passphrase. Without it no backup can be restored: keep the
# encrypted copy of these files (secrets.sh copy) and its private key safe.
PGBACKREST_REPO1_CIPHER_PASS=@generate:pgbackrest-cipher@
