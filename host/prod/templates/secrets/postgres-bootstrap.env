# `bootstrap` only: the administrator and the passwords it gives the application roles.
POSTGRES_ADMIN_USERNAME=aura_admin
POSTGRES_ADMIN_PASSWORD=@generate:admin@
POSTGRES_RUNTIME_PASSWORD=@generate:runtime@
POSTGRES_MIGRATOR_PASSWORD=@generate:migrator@
POSTGRES_INSPECTOR_PASSWORD=@generate:inspector@
# The crawler connects with it as aura_crawler_ingestion (host/prod/README.md#crawler).
POSTGRES_CRAWLER_INGESTION_PASSWORD=@generate:crawler@
