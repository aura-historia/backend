[Unit]
Description=Aura Historia prod daily encrypted copy of the secret files
Documentation=https://github.com/aura-historia/backend/blob/develop/host/prod/README.md

[Timer]
OnCalendar=*-*-* 04:00:00 UTC
Unit=aura-prod-secrets-copy.service
# Catch up once after downtime instead of skipping the run.
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
