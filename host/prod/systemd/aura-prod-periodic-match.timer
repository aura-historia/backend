[Unit]
Description=Aura Historia prod periodic saved-search matching at 15:00 UTC
Documentation=https://github.com/aura-historia/backend/blob/develop/host/prod/README.md

[Timer]
OnCalendar=*-*-* 15:00:00 UTC
Unit=aura-prod-ops@periodic-match.service
# Catch up once after downtime instead of skipping the run.
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
