# Installed by host/install.sh prod; @PROD_DIR@ is the stable checkout's host/prod directory.
[Unit]
Description=Aura Historia prod pgBackRest %i backup
Documentation=https://github.com/aura-historia/backend/blob/develop/host/prod/README.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=@PROD_DIR@/backup.sh %i
TimeoutStartSec=6h
