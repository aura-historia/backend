# Example environment for the crawler's `review-agent-runner`. Placeholders only: never commit real
# values, and never put the crawler's own settings here: the agents must not inherit the review
# console's human token or database credentials.
# Production: copy to /etc/crawler/review-agent-runner.env (mode 0640, owner root:crawler).
# Contract: docs/crawler/operations.md#review-agent-runner
#
# The unit sets CLAUDE_CONFIG_DIR, CRAWLER_REVIEW_AGENT_TOKEN_FILE and
# CRAWLER_REVIEW_AGENT_RUNNER_REVIEW_MCP_BIN. Empty or commented-out settings take their default.

# The Claude Code CLI, pinned and installed on the host (default: `claude` on the PATH).
#CRAWLER_REVIEW_AGENT_RUNNER_CLAUDE_BIN=/usr/local/bin/claude

# Each role's model (alias or full name), effort (low, medium, high, xhigh, max), turn cap and
# dollar cap per process.
#CRAWLER_REVIEW_AGENT_AUTHOR_MODEL=claude-opus-5-5
#CRAWLER_REVIEW_AGENT_AUTHOR_EFFORT=high
#CRAWLER_REVIEW_AGENT_AUTHOR_MAX_TURNS=80
#CRAWLER_REVIEW_AGENT_AUTHOR_MAX_BUDGET_USD=5
#CRAWLER_REVIEW_AGENT_REVIEWER_MODEL=claude-opus-5-5
#CRAWLER_REVIEW_AGENT_REVIEWER_EFFORT=high
#CRAWLER_REVIEW_AGENT_REVIEWER_MAX_TURNS=50
#CRAWLER_REVIEW_AGENT_REVIEWER_MAX_BUDGET_USD=3

# Reviews per run, agent processes at once, cooldown of a review that ended without a decision,
# and the wall-clock limit of one process.
#CRAWLER_REVIEW_AGENT_RUNNER_MAX_REVIEWS_PER_RUN=4
#CRAWLER_REVIEW_AGENT_RUNNER_MAX_PROCESSES=2
#CRAWLER_REVIEW_AGENT_RUNNER_COOLDOWN_MINUTES=180
#CRAWLER_REVIEW_AGENT_RUNNER_PROCESS_TIMEOUT_MINUTES=60

# Soft budgets of the rolling sums of total_cost_usd; calibrate from /usage of the crawler member.
#CRAWLER_REVIEW_AGENT_RUNNER_FIVE_HOUR_BUDGET_USD=20
#CRAWLER_REVIEW_AGENT_RUNNER_WEEKLY_BUDGET_USD=100

# Keep equal to the crawler's value: the author's prompt asks for this many labels of each kind.
#CRAWLER_REVIEW_AGENT_MIN_LABELLED_URLS=3

# The review console (default http://127.0.0.1:7878) and the JSON log level (default info).
#CRAWLER_REVIEW_CONSOLE_URL=http://127.0.0.1:7878
#LOG_LEVEL=info
