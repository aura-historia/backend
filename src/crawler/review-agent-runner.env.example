# Example environment for the crawler's `review-agent-runner`. Placeholders only: never commit real
# values, and never put the crawler's own settings here: the agents must not inherit the review
# console's human token or database credentials.
# Production: copy to /etc/crawler/review-agent-runner.env (mode 0640, owner root:crawler).
# Contract: docs/crawler/operations.md#review-agent-runner
#
# The unit sets HOME, CLAUDE_CONFIG_DIR, CRAWLER_REVIEW_AGENT_TOKEN_FILE and
# CRAWLER_REVIEW_AGENT_RUNNER_REVIEW_MCP_BIN. Empty or commented-out settings take their default.

# The Claude Code CLI, pinned and installed on the host outside /home and /root, which the unit's
# sandbox hides (default: `claude` on the PATH).
#CRAWLER_REVIEW_AGENT_RUNNER_CLAUDE_BIN=/usr/local/bin/claude

# Each role's model (alias or full name), effort (low, medium, high, xhigh, max) and turn cap per
# process.
#CRAWLER_REVIEW_AGENT_AUTHOR_MODEL=claude-sonnet-5-5
#CRAWLER_REVIEW_AGENT_AUTHOR_EFFORT=medium
#CRAWLER_REVIEW_AGENT_AUTHOR_MAX_TURNS=80
#CRAWLER_REVIEW_AGENT_REVIEWER_MODEL=claude-haiku-5-5
# Each role's model on URL-pattern reviews only. The author's is for the experiment of #2835 with a
# cheaper author; unset, a role's model on a URL-pattern review is its role's model.
#CRAWLER_REVIEW_AGENT_AUTHOR_URL_PATTERN_MODEL=claude-haiku-5-5
#CRAWLER_REVIEW_AGENT_REVIEWER_URL_PATTERN_MODEL=claude-sonnet-5-5
#CRAWLER_REVIEW_AGENT_REVIEWER_EFFORT=medium
#CRAWLER_REVIEW_AGENT_REVIEWER_MAX_TURNS=50

# Seconds between the end of one run and the start of the next. An idle run makes no agent call.
#CRAWLER_REVIEW_AGENT_RUNNER_INTERVAL_SECONDS=60
# The share (percent) of the login's five-hour and weekly usage windows the agents may take before
# the runner pauses; the weekly share is paced over the week.
#CRAWLER_REVIEW_AGENT_RUNNER_FIVE_HOUR_SHARE_PERCENT=100
#CRAWLER_REVIEW_AGENT_RUNNER_WEEKLY_SHARE_PERCENT=100

# Reviews per run, agent processes at once, cooldown of a review that ended without a decision,
# and the wall-clock limit of one process.
#CRAWLER_REVIEW_AGENT_RUNNER_MAX_REVIEWS_PER_RUN=60
#CRAWLER_REVIEW_AGENT_RUNNER_MAX_PROCESSES=20
#CRAWLER_REVIEW_AGENT_RUNNER_COOLDOWN_MINUTES=180
#CRAWLER_REVIEW_AGENT_RUNNER_PROCESS_TIMEOUT_MINUTES=60

# The limits of the agents' decisions, such as CRAWLER_REVIEW_AGENT_MAX_DECISIONS_PER_HOUR, are the
# crawler's settings: each run reads them from the review console, so they do not belong here.

# The review console (default http://127.0.0.1:7878) and the JSON log level (default info).
#CRAWLER_REVIEW_CONSOLE_URL=http://127.0.0.1:7878
#LOG_LEVEL=info
