# Example environment for the crawler `server` binary. Placeholders only: never commit real values.
# Production: copy to /etc/crawler/crawler.env (mode 0640, owner root:crawler) and fill in.
# Contract: docs/crawler/operations.md#single-server-deployment
#
# Leave optional settings commented out instead of empty: an empty CRAWLER_REVIEW_BIND_ADDR,
# CRAWLER_CLOUDWATCH_LOG_GROUP or CRAWLER_CLOUDWATCH_LOG_STREAM fails startup.

# Crawler-local PostgreSQL that the operator created; `server` only applies crawler migrations.
LOCAL_DB_URL=postgres://crawler:CHANGE_ME@127.0.0.1:5432/crawler_server

# Authoritative business PostgreSQL (ListingSource reads, ProductListing raw capture).
BUSINESS_DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@business-db.example.internal:5432/CHANGE_ME_DB?sslmode=require

# Spider page-body ceiling in bytes, 1048576 through 8388608.
SPIDER_MAX_SIZE_BYTES=8388608

# auto, review (default) or manual. manual makes no LLM call and reads no Vertex AI setting.
CRAWLER_AUTHORING_MODE=manual

# Review console. The bearer token is required for every review mutation and for a
# non-loopback bind; set a random value, e.g. from `openssl rand -hex 32`.
CRAWLER_REVIEW_AUTH_TOKEN=
#CRAWLER_REVIEW_BIND_ADDR=127.0.0.1:7878

# Base log level for the stdout JSON logs (default info).
#LOG_LEVEL=info

# Optional CloudWatch Logs export; uses the AWS SDK default credential chain.
#CRAWLER_CLOUDWATCH_LOG_GROUP=/aura-historia/crawler
#CRAWLER_CLOUDWATCH_LOG_STREAM=crawler-prod-1
#AWS_REGION=eu-central-1
#AWS_PROFILE=crawler

# Required only with CRAWLER_AUTHORING_MODE=review or auto.
#VERTEX_AI_PROJECT_ID=CHANGE_ME_PROJECT
#VERTEX_AI_LOCATION=CHANGE_ME_LOCATION
#GOOGLE_APPLICATION_CREDENTIALS=/etc/crawler/vertex-ai-credentials.json
