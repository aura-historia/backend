# Certbot obtains and renews this certificate during short, operator-controlled port-80 windows.
# The internal OpenSearch HTTPS certificate is the image's self-signed node certificate.
{
    auto_https disable_redirects
}

opensearch.stage.aura-historia.com:9443 {
    tls /certs/live/opensearch.stage.aura-historia.com/fullchain.pem /certs/live/opensearch.stage.aura-historia.com/privkey.pem

    # Only ProductListing search and projection routes are public.
    @runtime path /product-listings/_search /product-listings/_doc/*
    handle @runtime {
        reverse_proxy https://opensearch:9200 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
    handle {
        respond 403
    }
}
