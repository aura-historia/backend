# Certificate is supplied by the host operator; Caddy does not request or renew it.
# The internal OpenSearch HTTPS certificate is the image's self-signed node certificate.
{
    auto_https disable_redirects
}

opensearch.stage.aura-historia.com:9443 {
    tls /certs/fullchain.pem /certs/privkey.pem

    # Only the application search, projection and percolation routes are public.
    @runtime path /product-listings/_search /product-listings/_doc/* /user_search_filters/_search /user_search_filters/_doc/* /user_search_filters/_search/point_in_time /_search /_search/point_in_time
    handle @runtime {
        reverse_proxy https://opensearch:9200 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
    handle {
        respond 403
    }
}
