{
    "settings": {
        "index.knn": true,
        "knn.algo_param.ef_search": 512,
        "analysis": {
            "filter": {
                "english_stop": {
                    "type": "stop",
                    "stopwords": "_english_"
                },
                "english_stemmer": {
                    "type": "stemmer",
                    "language": "english"
                },
                "english_possessive_stemmer": {
                    "type": "stemmer",
                    "language": "possessive_english"
                },
                "german_stop": {
                    "type": "stop",
                    "stopwords": "_german_"
                },
                "german_stemmer": {
                    "type": "stemmer",
                    "language": "light_german"
                },
                "french_elision": {
                    "type": "elision",
                    "articles_case": true,
                    "articles": [
                        "l", "m", "t", "qu", "n", "s",
                        "j", "d", "c", "jusqu", "quoiqu",
                        "lorsqu", "puisqu"
                    ]
                },
                "french_stop": {
                    "type": "stop",
                    "stopwords": "_french_"
                },
                "french_stemmer": {
                    "type": "stemmer",
                    "language": "light_french"
                },
                "spanish_stop": {
                    "type": "stop",
                    "stopwords": "_spanish_"
                },
                "spanish_stemmer": {
                    "type": "stemmer",
                    "language": "light_spanish"
                }
            },
            "analyzer": {
                "classification_english": {
                    "tokenizer": "standard",
                    "filter": [
                        "english_possessive_stemmer",
                        "lowercase",
                        "english_stop",
                        "english_stemmer"
                    ]
                },
                "classification_german": {
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "german_stop",
                        "german_normalization",
                        "german_stemmer"
                    ]
                },
                "classification_french": {
                    "tokenizer": "standard",
                    "filter": [
                        "french_elision",
                        "lowercase",
                        "french_stop",
                        "french_stemmer"
                    ]
                },
                "classification_spanish": {
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "spanish_stop",
                        "spanish_stemmer"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "categoryKey": {
                "type": "keyword"
            },
            "categoryId": {
                "type": "keyword"
            },
            "metaName": {
                "type": "keyword"
            },
            "metaDescription": {
                "type": "keyword"
            },
            "metaKeywords": {
                "type": "keyword"
            },
            "embedding": {
                "type": "knn_vector",
                "dimension": 1024,
                "method": {
                    "engine": "faiss",
                    "space_type": "cosinesimil",
                    "name": "hnsw",
                    "parameters": {
                        "m": 128,
                        "ef_construction": 1024
                    }
                }
            },
            "displayNameDe": {
                "type": "text",
                "analyzer": "classification_german",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "displayNameEn": {
                "type": "text",
                "analyzer": "classification_english",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "displayNameFr": {
                "type": "text",
                "analyzer": "classification_french",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "displayNameEs": {
                "type": "text",
                "analyzer": "classification_spanish",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "displayDescriptionDe": {
                "type": "text",
                "analyzer": "classification_german"
            },
            "displayDescriptionEn": {
                "type": "text",
                "analyzer": "classification_english"
            },
            "displayDescriptionFr": {
                "type": "text",
                "analyzer": "classification_french"
            },
            "displayDescriptionEs": {
                "type": "text",
                "analyzer": "classification_spanish"
            },
            "created": {
                "type": "date",
                "format": "strict_date_time"
            },
            "updated": {
                "type": "date",
                "format": "strict_date_time"
            }
        }
    }
}
