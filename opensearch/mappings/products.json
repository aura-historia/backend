{
    "settings": {
        "index.knn": true,
        "knn.algo_param.ef_search": 128,
        "analysis": {
            "filter": {
                "english_stop": {
                    "type": "stop",
                    "stopwords": "_english_"
                },
                "english_stemmer": {
                    "type": "stemmer",
                    "language": "english"
                },
                "english_possessive_stemmer": {
                    "type": "stemmer",
                    "language": "possessive_english"
                },
                "german_stop": {
                    "type": "stop",
                    "stopwords": "_german_"
                },
                "german_stemmer": {
                    "type": "stemmer",
                    "language": "light_german"
                },
                "french_elision": {
                    "type": "elision",
                    "articles_case": true,
                    "articles": [
                        "l", "m", "t", "qu", "n", "s",
                        "j", "d", "c", "jusqu", "quoiqu",
                        "lorsqu", "puisqu"
                    ]
                },
                "french_stop": {
                    "type": "stop",
                    "stopwords": "_french_"
                },
                "french_stemmer": {
                    "type": "stemmer",
                    "language": "light_french"
                },
                "spanish_stop": {
                    "type": "stop",
                    "stopwords": "_spanish_"
                },
                "spanish_stemmer": {
                    "type": "stemmer",
                    "language": "light_spanish"
                },
                "antique_synonyms": {
                    "type": "synonym_graph",
                    "synonyms": [
                        "bureau desk, writing desk, secretary desk",
                        "commode, chest of drawers, dresser",
                        "armoire, wardrobe, clothes cabinet",
                        "armchair, easy chair, lounge chair",
                        "canapé, canape, sofa, couch, settee"
                    ]
                }
            },
            "analyzer": {
                "product_english": {
                    "tokenizer": "standard",
                    "filter": [
                        "english_possessive_stemmer",
                        "lowercase",
                        "antique_synonyms",
                        "english_stop",
                        "english_stemmer"
                    ]
                },
                "product_german": {
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "antique_synonyms",
                        "german_stop",
                        "german_normalization",
                        "german_stemmer"
                    ]
                },
                "product_french": {
                    "tokenizer": "standard",
                    "filter": [
                        "french_elision",
                        "lowercase",
                        "antique_synonyms",
                        "french_stop",
                        "french_stemmer"
                    ]
                },
                "product_spanish": {
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "antique_synonyms",
                        "spanish_stop",
                        "spanish_stemmer"
                    ]
                },
                "product_native": {
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "antique_synonyms",
                        "english_stop",
                        "german_stop",
                        "french_stop",
                        "spanish_stop"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "productId": {
                "type": "keyword"
            },
            "productSlugId": {
                "type": "keyword"
            },
            "shopSlugId": {
                "type": "keyword"
            },
            "eventId": {
                "type": "keyword"
            },
            "shopId": {
                "type": "keyword"
            },
            "shopsProductId": {
                "type": "keyword"
            },
            "shopName": {
                "type": "keyword"
            },
            "shopType": {
                "type": "keyword"
            },
            "categoryId": {
                "type": "keyword"
            },
            "categoryNameDe": {
                "type": "keyword"
            },
            "categoryNameEn": {
                "type": "keyword"
            },
            "categoryNameFr": {
                "type": "keyword"
            },
            "categoryNameEs": {
                "type": "keyword"
            },
            "periodId": {
                "type": "keyword"
            },
            "periodNameDe": {
                "type": "keyword"
            },
            "periodNameEn": {
                "type": "keyword"
            },
            "periodNameFr": {
                "type": "keyword"
            },
            "periodNameEs": {
                "type": "keyword"
            },
            "titleNative": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "text",
                        "analyzer": "product_native"
                    },
                    "language": {
                        "type": "keyword"
                    }
                }
            },
            "titleDe": {
                "type": "text",
                "analyzer": "product_german",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "titleEn": {
                "type": "text",
                "analyzer": "product_english",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "titleFr": {
                "type": "text",
                "analyzer": "product_french",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "titleEs": {
                "type": "text",
                "analyzer": "product_spanish",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    }
                }
            },
            "descriptionDe": {
                "type": "text",
                "analyzer": "product_german"
            },
            "descriptionEn": {
                "type": "text",
                "analyzer": "product_english"
            },
            "descriptionFr": {
                "type": "text",
                "analyzer": "product_french"
            },
            "descriptionEs": {
                "type": "text",
                "analyzer": "product_spanish"
            },
            "priceEur": {
                "type": "unsigned_long"
            },
            "priceUsd": {
                "type": "unsigned_long"
            },
            "priceBbp": {
                "type": "unsigned_long"
            },
            "priceAud": {
                "type": "unsigned_long"
            },
            "priceCad": {
                "type": "unsigned_long"
            },
            "priceNze": {
                "type": "unsigned_long"
            },
            "priceEstimateMinEur": {
                "type": "unsigned_long"
            },
            "priceEstimateMinUsd": {
                "type": "unsigned_long"
            },
            "priceEstimateMinGbp": {
                "type": "unsigned_long"
            },
            "priceEstimateMinAud": {
                "type": "unsigned_long"
            },
            "priceEstimateMinCad": {
                "type": "unsigned_long"
            },
            "priceEstimateMinNzd": {
                "type": "unsigned_long"
            },
            "priceEstimateMaxEur": {
                "type": "unsigned_long"
            },
            "priceEstimateMaxUsd": {
                "type": "unsigned_long"
            },
            "priceEstimateMaxGbp": {
                "type": "unsigned_long"
            },
            "priceEstimateMaxAud": {
                "type": "unsigned_long"
            },
            "priceEstimateMaxCad": {
                "type": "unsigned_long"
            },
            "priceEstimateMaxNzd": {
                "type": "unsigned_long"
            },
            "state": {
                "type": "keyword"
            },
            "url": {
                "type": "keyword"
            },
            "images": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "keyword"
                    },
                    "prohibitedContent": {
                        "type": "keyword"
                    }
                }
            },
            "textEmbedding": {
                "type": "knn_vector",
                "dimension": 1024,
                "method": {
                    "engine": "faiss",
                    "space_type": "cosinesimil",
                    "name": "hnsw",
                    "parameters": {
                        "m": 32,
                        "ef_construction": 1024,
                        "encoder": {
                            "name": "sq",
                            "parameters": {
                                "type": "fp16",
                                "clip": false
                            }
                        }
                    }
                }
            },
            "originYearMin": {
                "type": "integer"
            },
            "originYear": {
                "type": "integer"
            },
            "originYearMax": {
                "type": "integer"
            },
            "authenticity": {
                "type": "keyword"
            },
            "condition": {
                "type": "keyword"
            },
            "provenance": {
                "type": "keyword"
            },
            "restoration": {
                "type": "keyword"
            },
            "auctionStart": {
                "type": "date",
                "format": "strict_date_time"
            },
            "auctionEnd": {
                "type": "date",
                "format": "strict_date_time"
            },
            "created": {
                "type": "date",
                "format": "strict_date_time"
            },
            "updated": {
                "type": "date",
                "format": "strict_date_time"
            }
        }
    }
}
