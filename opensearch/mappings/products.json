                    },
                    "prohibitedContent": {
                        "type": "keyword"
                    }
                }
            },
            "embedding": {
                "type": "knn_vector",
                "dimension": 1024,
                "method": {
                    "engine": "faiss",
                    "space_type": "cosinesimil",
                    "name": "hnsw",
                    "parameters": {
                        "m": 32,
                        "ef_construction": 1024,
                        "encoder": {
                            "name": "sq",
                            "parameters": {
                                "type": "fp16",
                                "clip": false
                            }
                        }
                    }
                }
            },
            "originYearMin": {
