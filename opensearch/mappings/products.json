            },
            "titleNative": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "text"
                    },
                    "language": {
                        "type": "keyword"
                    }
                }
            },
            "titleDe": {
                "type": "text",
                "analyzer": "german",
                "search_analyzer": "german_with_synonyms"
            },
            "titleEn": {
                "type": "text",
                "analyzer": "english",
                "search_analyzer": "english_with_synonyms"
            },
            "titleFr": {
                "type": "text",
