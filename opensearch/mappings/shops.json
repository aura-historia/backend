{
    "settings": {
        "analysis": {
            "normalizer": {
                "lowercase_normalizer": {
                    "type": "custom",
                    "filter": ["lowercase"]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "shopId": {
                "type": "keyword"
            },
            "shopSlugId": {
                "type": "keyword"
            },
            "name": {
                "type": "text",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "normalizer": "lowercase_normalizer"
                    }
                }
            },
            "shopType": {
                "type": "keyword"
            },
            "domains": {
                "type": "keyword"
            },
            "url": {
                "type": "keyword"
            },
            "viewUrl": {
                "type": "keyword"
            },
            "image": {
                "type": "keyword"
            },
            "structuredAddressAddressline": {
                "type": "text"
            },
            "structuredAddressAddresslineExtra": {
                "type": "text"
            },
            "structuredAddressLocality": {
                "type": "keyword",
                "normalizer": "lowercase_normalizer"
            },
            "structuredAddressRegion": {
                "type": "keyword",
                "normalizer": "lowercase_normalizer"
            },
            "structuredAddressPostalCode": {
                "type": "keyword"
            },
            "structuredAddressCountry": {
                "type": "keyword"
            },
            "structuredAddressContinent": {
                "type": "keyword"
            },
            "geoAddress": {
                "type": "geo_point"
            },
            "phone": {
                "type": "keyword"
            },
            "email": {
                "type": "keyword",
                "normalizer": "lowercase_normalizer"
            },
            "specialitiesCategories": {
                "type": "keyword"
            },
            "specialitiesPeriods": {
                "type": "keyword"
            },
            "partnerStatus": {
                "type": "keyword"
            },
            "createdBy": {
                "type": "keyword"
            },
            "updatedBy": {
                "type": "keyword"
            },
            "created": {
                "type": "date",
                "format": "strict_date_time"
            },
            "updated": {
                "type": "date",
                "format": "strict_date_time"
            }
        },
        "dynamic": "strict"
    }
}
