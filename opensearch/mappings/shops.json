{
    "settings": {
        "analysis": {
            "normalizer": {
                "lowercase_normalizer": {
                    "type": "custom",
                    "filter": ["lowercase"]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "shopId": {
                "type": "keyword"
            },
            "shopSlugId": {
                "type": "keyword"
            },
            "name": {
                "type": "text",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "normalizer": "lowercase_normalizer"
                    }
                }
            },
            "shopType": {
                "type": "keyword"
            },
            "domains": {
                "type": "keyword"
            },
            "image": {
                "type": "keyword"
            },
            "partnerStatus": {
                "type": "keyword"
            },
            "created": {
                "type": "date",
                "format": "strict_date_time"
            },
            "updated": {
                "type": "date",
                "format": "strict_date_time"
            }
        }
    }
}
