{
    "settings": {
        "index.knn": true,
        "knn.algo_param.ef_search": 128,
        "analysis": {
            "filter": {
                "english_stop": {
                    "type": "stop",
                    "stopwords": "_english_"
                },
                "english_stemmer": {
                    "type": "stemmer",
                    "language": "english"
                },
                "english_possessive_stemmer": {
                    "type": "stemmer",
                    "language": "possessive_english"
                },
                "english_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/english_synonyms.txt",
                    "updateable": true
                },
                "german_stop": {
                    "type": "stop",
                    "stopwords": "_german_"
                },
                "german_stemmer": {
                    "type": "stemmer",
                    "language": "light_german"
                },
                "german_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/german_synonyms.txt",
                    "updateable": true
                },
                "french_stop": {
                    "type": "stop",
                    "stopwords": "_french_"
                },
                "french_stemmer": {
                    "type": "stemmer",
                    "language": "light_french"
                },
                "french_elision": {
                    "type": "elision",
                    "articles_case": true,
                    "articles": [
                        "l",
                        "m",
                        "t",
                        "qu",
                        "n",
                        "s",
                        "j",
                        "d",
                        "c",
                        "jusqu",
                        "quoiqu",
                        "lorsqu",
                        "puisqu"
                    ]
                },
                "french_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/french_synonyms.txt",
                    "updateable": true
                },
                "spanish_stop": {
                    "type": "stop",
                    "stopwords": "_spanish_"
                },
                "spanish_stemmer": {
                    "type": "stemmer",
                    "language": "light_spanish"
                },
                "spanish_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/spanish_synonyms.txt",
                    "updateable": true
                },
                "italian_stop": {
                    "type": "stop",
                    "stopwords": "_italian_"
                },
                "italian_stemmer": {
                    "type": "stemmer",
                    "language": "light_italian"
                },
                "italian_synonyms": {
                    "type": "synonym_graph",
                    "synonyms_path": "analysis/italian_synonyms.txt",
                    "updateable": true
                }
            },
            "analyzer": {
                "english_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "english_possessive_stemmer",
                        "lowercase",
                        "english_synonyms",
                        "english_stop",
                        "english_stemmer"
                    ]
                },
                "german_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "german_stop",
                        "german_synonyms",
                        "german_normalization",
                        "german_stemmer"
                    ]
                },
                "french_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "french_elision",
                        "lowercase",
                        "french_synonyms",
                        "french_stop",
                        "french_stemmer"
                    ]
                },
                "spanish_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "spanish_synonyms",
                        "spanish_stop",
                        "spanish_stemmer"
                    ]
                },
                "italian_with_synonyms": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "italian_synonyms",
                        "italian_stop",
                        "italian_stemmer"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "userSearchFilterId": {"type": "keyword"},
            "userId": {"type": "keyword"},
            "sourceVersion": {"type": "long"},
            "name": {"type": "keyword"},
            "notifications": {"type": "boolean"},
            "state": {"type": "keyword"},
            "query": {"type": "percolator"},
            "embedding": {
                "type": "knn_vector",
                "dimension": 768,
                "method": {
                    "engine": "faiss",
                    "space_type": "cosinesimil",
                    "name": "hnsw",
                    "parameters": {
                        "m": 32,
                        "ef_construction": 512,
                        "encoder": {
                            "name": "sq",
                            "parameters": {"type": "fp16", "clip": false}
                        }
                    }
                }
            },
            "search": {
                "type": "object",
                "enabled": true,
                "properties": {
                    "language": {"type": "keyword"},
                    "currency": {"type": "keyword"},
                    "productQuery": {"type": "keyword"},
                    "enhancedSearchDescription": {"type": "keyword"},
                    "excludeProductId": {"type": "keyword"},
                    "listingSourceId": {"type": "keyword"},
                    "excludeListingSourceId": {"type": "keyword"},
                    "price": {
                        "type": "object",
                        "properties": {
                            "min": {"type": "unsigned_long"},
                            "max": {"type": "unsigned_long"}
                        }
                    },
                    "availability": {
                        "type": "object",
                        "properties": {
                            "availability": {"type": "keyword"},
                            "orderability": {"type": "keyword"},
                            "includeUnspecified": {"type": "boolean"}
                        }
                    },
                    "created": {
                        "type": "object",
                        "properties": {
                            "min": {"type": "date", "format": "strict_date_time"},
                            "max": {"type": "date", "format": "strict_date_time"}
                        }
                    },
                    "updated": {
                        "type": "object",
                        "properties": {
                            "min": {"type": "date", "format": "strict_date_time"},
                            "max": {"type": "date", "format": "strict_date_time"}
                        }
                    },
                    "auctionStart": {
                        "type": "object",
                        "properties": {
                            "min": {"type": "date", "format": "strict_date_time"},
                            "max": {"type": "date", "format": "strict_date_time"}
                        }
                    },
                    "auctionEnd": {
                        "type": "object",
                        "properties": {
                            "min": {"type": "date", "format": "strict_date_time"},
                            "max": {"type": "date", "format": "strict_date_time"}
                        }
                    }
                }
            },
            "created": {"type": "date", "format": "strict_date_time"},
            "updated": {"type": "date", "format": "strict_date_time"}
        }
    }
}
