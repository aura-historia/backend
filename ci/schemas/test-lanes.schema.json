{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura-historia.com/ci/test-lanes.schema.json",
  "title": "Explicit Cargo test target lane assignments",
  "type": "object",
  "required": ["schema_version", "purpose", "lanes", "packages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "purpose": { "const": "INVENTORY_ONLY" },
    "lanes": {
      "type": "object",
      "required": ["API", "CRAWLER", "INFRASTRUCTURE", "REMAINING"],
      "additionalProperties": {
        "type": "object",
        "required": ["runner", "description"],
        "properties": { "runner": { "type": "string" }, "description": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "targets"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "lane", "test", "doctest", "harness", "required_features"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[^:]+::[^:]+::[^:]+$" },
                "lane": { "enum": ["API", "CRAWLER", "INFRASTRUCTURE", "REMAINING"] },
                "test": { "type": "boolean" },
                "doctest": { "type": "boolean" },
                "harness": { "type": "boolean" },
                "required_features": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
