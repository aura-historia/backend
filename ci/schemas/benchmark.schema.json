{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura-historia.com/ci/benchmark.schema.json",
  "title": "Measured package baseline, including incomplete or failed runs",
  "type": "object",
  "required": ["schema_version", "kind", "status", "started_at", "run", "stages", "observations", "error", "measurement_seconds", "workflow_seconds"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "PACKAGE_BASELINE" },
    "status": { "enum": ["PASSED", "FAILED"] },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dirty": { "type": "boolean" },
    "scenario": {
      "type": "object", "required": ["id", "package", "repeat"],
      "properties": { "id": { "enum": ["LEAF", "API", "FIXTURE"] }, "package": { "type": "string" }, "repeat": { "type": "integer", "minimum": 1 } }
    },
    "cache": {
      "type": "object", "required": ["mode", "target_dir", "initially_populated", "definition"],
      "properties": { "mode": { "enum": ["COLD_TARGET", "WARM_TARGET"] }, "target_dir": { "type": "string" }, "initially_populated": { "type": "boolean" }, "definition": { "type": "string" } }
    },
    "run": {
      "type": "object", "required": ["id", "attempt", "job", "job_queued_at", "job_started_at"],
      "properties": {
        "scheduling_delay_seconds": { "type": ["number", "null"], "minimum": 0 },
        "repository": { "type": ["string", "null"] },
        "workflow_ref": { "type": ["string", "null"] },
        "workflow_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "runner": { "type": "object", "required": ["os", "logical_cpus", "memory_total_kib", "rustc", "cargo", "grcov", "docker", "build_environment"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "cwd", "status", "exit_code", "seconds", "peak_rss_kib", "target_disk_before_bytes", "target_disk_after_bytes", "target_disk_peak_sampled_bytes", "log"],
        "properties": {
          "name": { "enum": ["COMPILE_LINK", "TESTS_AND_FIXTURES", "COVERAGE"] },
          "command": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["PASSED", "FAILED"] },
          "exit_code": { "type": "integer" },
          "seconds": { "type": "number", "minimum": 0 },
          "peak_rss_kib": { "type": ["integer", "null"], "minimum": 0 },
          "target_disk_peak_sampled_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "observations": { "type": ["object", "null"] },
    "coverage": { "type": "object", "required": ["status", "totals"], "properties": { "status": { "enum": ["PENDING", "COLLECTED", "FAILED", "NOT_REQUESTED"] }, "totals": { "type": ["object", "null"] } } },
    "error": { "type": ["string", "null"] },
    "measurement_seconds": { "type": "number", "minimum": 0 },
    "workflow_seconds": { "type": ["number", "null"], "minimum": 0 }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "PASSED" } } },
    "then": { "required": ["revision", "dirty", "scenario", "cache", "feature_scope", "runner", "coverage", "images_before", "images_after"], "properties": { "stages": { "minItems": 2 } } }
  }]
}
