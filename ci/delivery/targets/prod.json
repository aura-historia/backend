{
  "version": 1,
  "target": "prod",
  "account": "${AWS_ACCOUNT_ID}",
  "region": "eu-central-1",
  "stackNames": [
    "application-prod-network",
    "application-prod-data",
    "application-prod-identity",
    "application-prod-initialize",
    "application-prod-migrate",
    "application-prod-compute",
    "application-prod-api",
    "application-prod-observability"
  ],
  "reviewer": {
    "modelId": "${DELIVERY_REVIEW_MODEL_ID}",
    "effort": "high",
    "apiKeyParameterName": "/anthropic/prod/api-key",
    "maxTokens": 16000
  },
  "runtimeExecutionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/aura-historia/delivery/aura-delivery-prod-cloudformation",
  "migrationExecutionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/aura-historia/delivery/aura-delivery-prod-migration-cloudformation",
  "apiUrl": "https://api.aura-historia.com",
  "mcpUrl": "https://mcp.aura-historia.com"
}
