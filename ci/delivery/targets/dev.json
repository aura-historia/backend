{
  "version": 1,
  "target": "dev",
  "account": "${AWS_ACCOUNT_ID}",
  "region": "eu-central-1",
  "stackNames": [
    "application-dev-network",
    "application-dev-data",
    "application-dev-identity",
    "application-dev-initialize",
    "application-dev-migrate",
    "application-dev-compute",
    "application-dev-api"
  ],
  "reviewer": {
    "modelId": "${DELIVERY_REVIEW_MODEL_ID}",
    "region": "eu-central-1",
    "maxTokens": 8192
  },
  "runtimeExecutionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/aura-historia/delivery/aura-delivery-dev-cloudformation",
  "migrationExecutionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/aura-historia/delivery/aura-delivery-dev-migration-cloudformation",
  "apiUrl": "https://api.stage.aura-historia.com",
  "mcpUrl": "https://mcp.stage.aura-historia.com"
}
